# FASL / compiled output
*.fasl
*.fas
*.lx32fsl
*.lx64fsl
*.dx32fsl
*.dx64fsl
*.64ufasl
*.ofasl
*.lib
*.dfsl
*.pfsl
*.d64fsl
*.p64fsl
*.lx64fsl
*.o
*.so

# ASDF cache
.asdf-cache/
.cache/
compiled-cache/

# Editor/OS junk
.DS_Store
*~
\#*\#
.\#*
.idea/
.vscode/
*.swp

# ROM images — copyrighted, must not be checked in
roms/*.rom
roms/*.ROM
roms/*.bin
roms/*.atr
!roms/.gitkeep

# Acid800 test suite (fetch-acid800.sh) — third-party binaries, not vendored.
# No trailing slash: the fetched directory may appear as a symlink into
# another checkout, which the directory-only pattern would not match.
roms/acid800

# Local quickproject / sly state
.sbclrc.local

# Environment
.env

# Assembly builds
asm/build
asm/*.lst
asm/*.lab
asm/*.obx
asm/*.xex

# Python bytecode cache (scripts/capture-screenshot.py etc.)
__pycache__/
*.pyc

# EdVenture (github.com/EdSalisbury/edventure) -- a separate, independently
# versioned project. scripts/edventure-demo.lisp clones it fresh into a
# temp directory on each run and cleans up after itself; a local checkout
# here (for manual poking around) must never be committed.
/edventure/
